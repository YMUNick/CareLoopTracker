# All optional.

# Shared database (Supabase Postgres, transaction pooler, port 6543).
# Without it: PGlite (local file in dev, in-memory and unshared on Vercel).
DATABASE_URL=

# AI drafting. Without these, the app uses a fixed template instead.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Protects /api/cron/escalations (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
